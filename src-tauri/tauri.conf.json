{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MultiCLI Workbench",
  "version": "0.1.0",
  "identifier": "local.multicli.workbench",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://localhost:1427",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/agent-catalogs": "agent-catalogs",
      "resources/skills": "skills"
    },
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis"
    ],
    "linux": {
      "rpm": {
        "compression": {
          "type": "zstd",
          "level": 3
        },
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3",
          "librsvg2"
        ]
      }
    },
    "icon": [
      "multicli-icons/icon.ico",
      "multicli-icons/32x32.png",
      "multicli-icons/128x128.png",
      "multicli-icons/128x128@2x.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    }
  },
  "plugins": {}
}
